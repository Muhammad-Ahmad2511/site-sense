PORT=3000

# Whole Website safety limits. The crawler stops when either limit is reached.
MAX_CRAWL_PAGES=120
MAX_CRAWL_DURATION_MS=240000

# Homepage and internal page loading limits.
AUDIT_TIMEOUT_MS=25000
INTERNAL_PAGE_TIMEOUT_MS=9000

# Faster internal SEO crawl. Increase settle/render wait only for heavily client-rendered sites.
CRAWL_CONCURRENCY=6
FAST_PAGE_SETTLE_MS=100
FAST_RENDER_WAIT_MS=900

# Full axe accessibility runs are sampled; all other pages still receive lightweight DOM checks.
ACCESSIBILITY_SAMPLE_PAGES=2

# Optional. The audit itself works without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Public domain authority/popularity benchmark (Tranco). Set false to disable the external rank lookup.
AUTHORITY_LOOKUP_ENABLED=true
AUTHORITY_LOOKUP_TIMEOUT_MS=8000
AUTHORITY_RDAP_TIMEOUT_MS=5000

# If the individual rank API fails, use the official latest Tranco top-1M ZIP.
AUTHORITY_LIST_TIMEOUT_MS=25000
AUTHORITY_LIST_CACHE_MAX_AGE_MS=86400000
AUTHORITY_STALE_LIST_CACHE_MAX_AGE_MS=604800000

# Reuse successful domain ranks for 7 days; stale values can rescue temporary outages for up to 30 days.
AUTHORITY_CACHE_MAX_AGE_MS=604800000
AUTHORITY_STALE_CACHE_MAX_AGE_MS=2592000000

# Optional: override the realistic browser identity used for public audits.
# AUDIT_BROWSER_USER_AGENT=Mozilla/5.0 ...
