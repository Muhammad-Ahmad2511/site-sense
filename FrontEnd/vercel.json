{



  "framework": null,



  "buildCommand": "npm run build:vercel",



  "outputDirectory": "dist",



  "rewrites": [



    {



      "source": "/auth",



      "destination": "/auth/index.html"



    },



    {



      "source": "/auth/",



      "destination": "/auth/index.html"



    },



    {



      "source": "/api/:path*",



      "destination": "https://site-sense-production.up.railway.app/api/:path*" 



    }



  ]



} 