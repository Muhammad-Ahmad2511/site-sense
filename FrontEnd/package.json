{
  "name": "site-sense-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site-Sense frontend workspace — landing (marketing site + audit tool) and auth (sign in/up), sharing components/constants/styles from src/shared. Builds both into ../BackEnd/public and is served by the existing Express static middleware — no backend changes required.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "tsc --noEmit && vite build --outDir dist --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
